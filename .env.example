# Copy to .env and fill in from your Supabase dashboard (never commit .env).
# All auth features degrade gracefully when these are unset — anonymous play
# works with no configuration at all.

# ----- Client (bundled by Vite; safe to expose publicly) -----
# Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API Keys -> publishable key
# (new "sb_publishable_..." format, or the legacy anon JWT — both work)
VITE_SUPABASE_ANON_KEY=
# Where OAuth redirects land. Local dev: http://localhost:5173
# Production: your deployed origin, e.g. https://arcade.onrender.com
VITE_APP_BASE_URL=http://localhost:5173

# ----- Server only (SECRET — never expose to the client) -----
# Same Project URL as above
SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API Keys -> secret key
# (new "sb_secret_..." format, or the legacy service_role JWT — both work)
SUPABASE_SERVICE_ROLE_KEY=
# ONLY for legacy projects using the shared HS256 JWT secret (Project
# Settings -> API -> JWT Settings). Projects on the new asymmetric JWT
# signing keys should LEAVE THIS UNSET — tokens are verified via the public
# JWKS endpoint derived from SUPABASE_URL, no secret needed.
SUPABASE_JWT_SECRET=

PORT=3001
