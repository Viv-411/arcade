# Copy to .env and fill in from your Supabase dashboard (never commit .env).
# All auth features degrade gracefully when these are unset — anonymous play
# works with no configuration at all.

# ----- Client (bundled by Vite; safe to expose publicly) -----
# Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API -> anon/public key
VITE_SUPABASE_ANON_KEY=
# Where OAuth redirects land. Local dev: http://localhost:5173
# Production: your deployed origin, e.g. https://arcade.onrender.com
VITE_APP_BASE_URL=http://localhost:5173

# ----- Server only (SECRET — never expose to the client) -----
# Same Project URL as above
SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API -> service_role key (SECRET)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=

PORT=3001
